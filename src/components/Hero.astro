---
import { business } from '../data/business';
import { links } from '../data/links';
import Emblem from './brand/Emblem.astro';
import Icon from './Icon.astro';
import OpeningStatus from './OpeningStatus.astro';
---

<section class="heroe relative isolate overflow-x-clip" aria-labelledby="heroe-titulo">
  <div class="contenedor grid items-center gap-y-4 pt-4 pb-16 sm:pt-8 lg:grid-cols-12 lg:gap-x-8 lg:pt-10 lg:pb-12">
    <div class="order-2 lg:order-1 lg:col-span-7">
      <h1 id="heroe-titulo" class="text-display font-normal tracking-[-0.02em]">
        Depilación láser y estética
      </h1>
      <p class="text-entradilla mt-6 max-w-[33rem] text-velo">
        Para mujeres y hombres, con un plan de sesiones pensado para tu piel y tu vello. Te
        atendemos con cita previa en{' '}
        <span class="whitespace-nowrap">{business.address.display}</span>.
      </p>
      <div id="heroe-acciones" class="mt-9 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
        <a class="btn btn-principal" href={links.whatsapp} target="_blank" rel="noopener">
          <Icon name="chat" />
          Pedir cita por WhatsApp
        </a>
        <a class="btn btn-secundario" href="#zonas">
          Ver zonas y sesiones
        </a>
      </div>
      <OpeningStatus class="mt-7" />
    </div>

    <div class="order-1 lg:order-2 lg:col-span-5">
      <div class="heroe__emblema mx-auto w-[min(76vw,21rem)] sm:w-[25rem] lg:w-full">
        <Emblem />
      </div>
    </div>
  </div>
</section>

<style>
  /* Halo cálido detrás del emblema: la «luz» del láser sobre la piel. */
  .heroe::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: -20% -10% auto auto;
    width: min(70rem, 120vw);
    aspect-ratio: 1;
    background: radial-gradient(
      closest-side,
      #fbe4dd 0%,
      rgb(251 228 221 / 0.55) 45%,
      transparent 100%
    );
    pointer-events: none;
  }

  @media (width < 64rem) {
    .heroe::before {
      inset: -18rem auto auto 50%;
      translate: -50% 0;
      width: 44rem;
    }
  }
</style>
