---
import logo from '../assets/brand/logo.svg';
import { business, phoneLabel } from '../data/business';
import { links } from '../data/links';
import { navigation } from '../data/navigation';
import { formatRanges, groupSchedule } from '../lib/hours';
import WhatsAppFab from './WhatsAppFab.astro';

const groups = groupSchedule(business.hours);
const year = new Date().getFullYear();
---

<footer class="bg-rubor pb-24 md:pb-0">
  <div class="contenedor grid gap-x-10 gap-y-12 py-16 sm:grid-cols-2 lg:grid-cols-12 lg:py-20">
    <div class="sm:col-span-2 lg:col-span-4">
      <img
        src={logo.src}
        width="208"
        height="231"
        alt={`${business.name}, ${business.tagline.toLowerCase()}`}
        loading="lazy"
        decoding="async"
        class="h-auto w-[11.5rem] lg:w-[13rem]"
      />
    </div>

    <div class="lg:col-span-3">
      <h2 class="pie__titulo">Visítanos</h2>
      <p class="mt-3">{business.address.display}</p>
      <p class="text-velo">Con cita previa</p>
      <dl class="mt-4 space-y-2 text-[0.9375rem]">
        {groups.map((group) => (
          <div>
            <dt class="font-medium">{group.label}</dt>
            <dd class="text-velo">{formatRanges(group.ranges)}</dd>
          </div>
        ))}
      </dl>
    </div>

    <nav class="lg:col-span-2" aria-label="Secciones">
      <h2 class="pie__titulo">Secciones</h2>
      <ul class="mt-3 space-y-1.5">
        {navigation.map((item) => (
          <li>
            <a href={item.href} class="pie__enlace">
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="lg:col-span-3">
      <h2 class="pie__titulo">Contacto</h2>
      <ul class="mt-3 space-y-1.5">
        <li>
          <a href={links.whatsapp} class="pie__enlace" target="_blank" rel="noopener">
            WhatsApp: {phoneLabel}
          </a>
        </li>
        <li>
          <a href={links.phone} class="pie__enlace">
            Llamar:&nbsp;{phoneLabel}
          </a>
        </li>
        <li>
          <a href={links.instagram} class="pie__enlace" target="_blank" rel="noopener">
            Instagram: @{business.instagram.handle}
          </a>
        </li>
        <li>
          <a href={links.maps} class="pie__enlace" target="_blank" rel="noopener">
            Cómo llegar
          </a>
        </li>
      </ul>
    </div>
  </div>

  <div class="border-t border-linea">
    <div class="contenedor flex flex-col gap-3 py-6 text-[0.875rem] text-velo sm:flex-row sm:flex-wrap sm:items-center sm:justify-between">
      <p>
        © {year} {business.name}
      </p>
      <ul class="flex flex-wrap gap-x-6 gap-y-2">
        <li>
          <a href="/aviso-legal/" class="pie__enlace">
            Aviso legal
          </a>
        </li>
        <li>
          <a href="/privacidad/" class="pie__enlace">
            Privacidad y cookies
          </a>
        </li>
      </ul>
      {business.credit && (
        <p>
          {business.credit.url ? (
            <a href={business.credit.url} class="pie__enlace" target="_blank" rel="noopener">
              {business.credit.text}
            </a>
          ) : (
            business.credit.text
          )}
        </p>
      )}
    </div>
  </div>

  <!-- Dentro del pie para que quede en un landmark; se muestra fijo en pantalla. -->
  <WhatsAppFab />
</footer>

<style>
  .pie__titulo {
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    color: var(--color-cobre);
  }

  .pie__enlace {
    display: inline-block;
    padding-block: 0.2rem;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .pie__enlace:hover {
    color: var(--color-cobre-oscuro);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
</style>
