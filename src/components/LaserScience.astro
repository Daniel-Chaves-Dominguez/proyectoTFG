---
/**
 * Explicación del funcionamiento del láser con un corte de piel ilustrado.
 * El botón «Simular un disparo» reproduce el pulso de luz; la ilustración ya
 * muestra el resultado en reposo, así que no hace falta pulsarlo para entenderla.
 */
import Icon from './Icon.astro';

const phases = [
  {
    name: 'Crecimiento',
    text: 'El vello sigue unido a la raíz: absorbe la luz y el folículo se debilita.',
  },
  {
    name: 'Transición',
    text: 'El vello se está separando de la raíz y apenas responde.',
  },
  {
    name: 'Reposo',
    text: 'Responderá en otra sesión, cuando vuelva a crecer.',
  },
];

const follicles = [107, 320, 533] as const;
---

<section
  id="laser"
  class="seccion bg-cacao-profundo text-noche-texto"
  aria-labelledby="laser-titulo"
>
  <div class="contenedor grid gap-x-14 gap-y-12 lg:grid-cols-12 lg:items-center">
    <div class="lg:col-span-5">
      <h2 id="laser-titulo" class="text-titulo">
        Cómo actúa el láser
      </h2>
      <p class="mt-6 text-noche-velo">
        El láser emite una luz que absorbe el pigmento del vello. Esa energía se convierte en calor
        en la raíz y debilita el folículo, así que el vello vuelve a salir cada vez más fino y
        escaso. La piel de alrededor apenas absorbe esa luz y el equipo la enfría en cada disparo.
      </p>
      <p class="mt-4 text-noche-velo">
        El folículo solo responde mientras el vello está creciendo. Como en cada momento solo una
        parte del vello está en esa fase, hacen falta varias sesiones separadas unas semanas.
      </p>
      <button type="button" class="btn btn-noche mt-9" data-disparo>
        <Icon name="zap" />
        Simular un disparo
      </button>
    </div>

    <figure class="diagrama lg:col-span-7" data-diagrama>
      <svg
        viewBox="0 0 640 380"
        role="img"
        aria-labelledby="diagrama-titulo"
        class="block h-auto w-full"
      >
        <title id="diagrama-titulo">
          Corte de la piel con tres folículos: el láser actúa sobre el que está en fase de
          crecimiento.
        </title>
        <defs>
          <linearGradient id="diagrama-haz" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#FFD9CE" stop-opacity=".75"></stop>
            <stop offset="1" stop-color="#F2A99A" stop-opacity=".22"></stop>
          </linearGradient>
          <linearGradient id="diagrama-haz-piel" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#F2A99A" stop-opacity=".28"></stop>
            <stop offset="1" stop-color="#F2A99A" stop-opacity="0"></stop>
          </linearGradient>
          <radialGradient id="diagrama-calor">
            <stop offset="0" stop-color="#FFF3EE"></stop>
            <stop offset=".3" stop-color="#F7C6BB" stop-opacity=".85"></stop>
            <stop offset="1" stop-color="#F4BDB2" stop-opacity="0"></stop>
          </radialGradient>
        </defs>

        <!-- Piel: dermis y epidermis -->
        <rect x="0" y="160" width="640" height="220" fill="#F4BDB2" fill-opacity=".05"></rect>
        <path
          d="M0 160c80-4 160 4 240 0s160-4 240 0 120 4 160 0v24H0z"
          fill="#F4BDB2"
          fill-opacity=".1"
        ></path>

        <!-- Cabezal y haz de luz -->
        <g class="diagrama__haz">
          <rect
            x="50"
            y="10"
            width="540"
            height="26"
            rx="13"
            fill="#F4BDB2"
            fill-opacity=".1"
            stroke="#E9B1A6"
            stroke-opacity=".6"
          ></rect>
          <g style="mix-blend-mode: screen">
            <path d="M70 36h500l20 124H50z" fill="url(#diagrama-haz)"></path>
            <rect x="50" y="160" width="540" height="200" fill="url(#diagrama-haz-piel)"></rect>
          </g>
        </g>

        <!-- Folículo en crecimiento (anágeno): el láser lo debilita -->
        <circle
          class="diagrama__calor"
          cx={follicles[0]}
          cy="330"
          r="64"
          fill="url(#diagrama-calor)"
        ></circle>
        <path
          d="M96 160c0 68-1 126-6 152-5 28 10 44 17 44s22-16 17-44c-5-26-6-84-6-152"
          fill="#F4BDB2"
          fill-opacity=".08"
          stroke="#E9B1A6"
          stroke-opacity=".65"
        ></path>
        <line
          x1={follicles[0]}
          y1="326"
          x2={follicles[0]}
          y2="150"
          stroke="#E3A396"
          stroke-width="4"
          stroke-linecap="round"
        ></line>
        <ellipse
          class="diagrama__raiz"
          cx={follicles[0]}
          cy="330"
          rx="13"
          ry="17"
          fill="#C98276"
        ></ellipse>
        <ellipse cx={follicles[0]} cy="343" rx="6" ry="7" fill="#2B2122"></ellipse>

        <!-- Folículo en transición (catágeno) -->
        <path
          d="M310 160c0 40 1 80 2 102 1 20 15 20 16 0 1-22 2-62 2-102"
          fill="#F4BDB2"
          fill-opacity=".06"
          stroke="#E9B1A6"
          stroke-opacity=".5"
        ></path>
        <line
          x1={follicles[1]}
          y1="262"
          x2={follicles[1]}
          y2="150"
          stroke="#E3A396"
          stroke-width="3.4"
          stroke-linecap="round"
        ></line>
        <ellipse cx={follicles[1]} cy="262" rx="7" ry="9" fill="#E9B1A6"></ellipse>
        <line
          x1={follicles[1]}
          y1="278"
          x2={follicles[1]}
          y2="334"
          stroke="#E9B1A6"
          stroke-opacity=".45"
          stroke-dasharray="3 5"
        ></line>

        <!-- Folículo en reposo (telógeno) -->
        <path
          d="M523 160c0 25 1 45 2 54 1 13 15 13 16 0 1-9 2-29 2-54"
          fill="#F4BDB2"
          fill-opacity=".06"
          stroke="#E9B1A6"
          stroke-opacity=".5"
        ></path>
        <line
          x1={follicles[2]}
          y1="208"
          x2={follicles[2]}
          y2="150"
          stroke="#E3A396"
          stroke-width="3"
          stroke-linecap="round"
        ></line>
        <ellipse cx={follicles[2]} cy="208" rx="6" ry="8" fill="#E9B1A6"></ellipse>
        <ellipse
          cx={follicles[2]}
          cy="254"
          rx="8"
          ry="10"
          fill="none"
          stroke="#E9B1A6"
          stroke-opacity=".55"
          stroke-dasharray="2 3"
        ></ellipse>

        <!-- Superficie de la piel -->
        <path
          d="M0 160c80-4 160 4 240 0s160-4 240 0 120 4 160 0"
          fill="none"
          stroke="#E9B1A6"
          stroke-width="1.5"
        ></path>
      </svg>

      <figcaption class="mt-6">
        <ul class="grid gap-5 sm:grid-cols-3 sm:gap-4">
          {phases.map((phase, i) => (
            <li class="fase sm:text-center" data-activa={i === 0 ? '' : undefined}>
              <span class="font-serif text-[1.375rem] text-noche-texto">{phase.name}</span>
              <span class="mt-1 block text-[0.9375rem] leading-snug text-noche-velo">
                {phase.text}
              </span>
            </li>
          ))}
        </ul>
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .btn-noche {
    border: 1px solid rgb(233 177 166 / 0.6);
    color: var(--color-noche-texto);
  }

  .btn-noche:hover {
    background-color: rgb(244 189 178 / 0.12);
    border-color: var(--color-oro-rosa-claro);
  }

  #laser :focus-visible {
    outline-color: var(--color-oro-rosa-claro);
  }

  .fase {
    padding-top: 1rem;
    border-top: 1px solid rgb(233 177 166 / 0.25);
  }

  .fase[data-activa] {
    border-top-color: var(--color-oro-rosa);
  }

  .diagrama__haz {
    opacity: 0.45;
  }

  .diagrama__calor {
    opacity: 0.85;
    transform-box: fill-box;
    transform-origin: center;
  }

  .disparando .diagrama__haz {
    animation: diagrama-haz 0.9s ease-out both;
  }

  .disparando .diagrama__calor {
    animation: diagrama-calor 1.3s ease-out 0.08s both;
  }

  .disparando .diagrama__raiz {
    animation: diagrama-raiz 1.3s ease-out 0.08s both;
  }

  @keyframes diagrama-haz {
    0% {
      opacity: 0.45;
    }
    8% {
      opacity: 1;
    }
    100% {
      opacity: 0.45;
    }
  }

  @keyframes diagrama-calor {
    0% {
      opacity: 0.5;
      transform: scale(0.7);
    }
    25% {
      opacity: 1;
      transform: scale(1.3);
    }
    100% {
      opacity: 0.85;
      transform: scale(1);
    }
  }

  @keyframes diagrama-raiz {
    25% {
      fill: #ffd9ce;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .disparando .diagrama__calor {
      animation-name: diagrama-calor-suave;
    }

    @keyframes diagrama-calor-suave {
      25% {
        opacity: 1;
      }
    }
  }
</style>

<script>
  const button = document.querySelector<HTMLButtonElement>('[data-disparo]');
  const figure = document.querySelector<HTMLElement>('[data-diagrama]');

  button?.addEventListener('click', () => {
    if (!figure) return;
    figure.classList.remove('disparando');
    void figure.offsetWidth; // reinicia la animación si se pulsa varias veces
    figure.classList.add('disparando');
  });
</script>
