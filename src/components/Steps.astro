---
const steps = [
  {
    title: 'Escríbenos',
    text: 'Cuéntanos por WhatsApp qué zona quieres tratar y buscamos un hueco que te venga bien.',
  },
  {
    title: 'Valoración',
    text: 'Revisamos tu piel y tu vello, te preguntamos por medicación o tratamientos recientes y hacemos una prueba en una zona pequeña.',
  },
  {
    title: 'Sesiones',
    text: 'Según la zona, desde unos minutos hasta alrededor de una hora. Notarás calor y pequeños pinchazos con cada disparo.',
  },
  {
    title: 'Resultados',
    text: 'El vello tratado se cae solo en las dos o tres semanas siguientes. Con cada sesión notarás menos vello y más fino.',
  },
];
---

<section id="paso-a-paso" class="seccion" aria-labelledby="pasos-titulo">
  <div class="contenedor">
    <h2 id="pasos-titulo" class="text-titulo">
      Paso a paso
    </h2>
    <ol class="pasos mt-12 grid gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-4">
      {steps.map((step, i) => (
        <li class="paso">
          <span class="paso__numero font-serif" aria-hidden="true">
            {i + 1}
          </span>
          <h3 class="mt-5 text-[1.625rem] leading-tight">{step.title}</h3>
          <p class="mt-2.5 text-velo">{step.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .paso {
    position: relative;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-linea);
  }

  .paso__numero {
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    margin-top: -2.9rem;
    border-radius: 999px;
    border: 1px solid var(--color-oro-rosa);
    background-color: var(--color-polvo);
    color: var(--color-cobre);
    font-size: 1.625rem;
    line-height: 1;
  }
</style>
