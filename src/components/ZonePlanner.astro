---
/**
 * Selector de zonas: un grupo de radios nativo (accesible y sin JavaScript).
 * El panel visible se elige con :has(); sin soporte, se muestran todos.
 */
import { business } from '../data/business';
import { treatmentMonths, treatmentPhrase, zoneGroups } from '../data/zones';
import { whatsappUrl } from '../lib/whatsapp';
import Icon from './Icon.astro';

const DEFAULT_ZONE = 'axilas-ingles';

const range = ([min, max]: [number, number]) => (min === max ? `${min}` : `${min} a ${max}`);
const euros = new Intl.NumberFormat('es-ES', { style: 'currency', currency: 'EUR' });

const panelCss = zoneGroups
  .map(
    (g) =>
      `.planificador:has(#zona-${g.id}:checked) .panel-zona[data-zona="${g.id}"]{display:grid}`,
  )
  .join('');
---

<section id="zonas" class="seccion bg-rubor" aria-labelledby="zonas-titulo">
  <div class="contenedor">
    <div class="max-w-[40rem]">
      <h2 id="zonas-titulo" class="text-titulo">
        Zonas y sesiones
      </h2>
      <p class="mt-5 text-velo">
        Cada zona tiene su propio ritmo de crecimiento. Elige una para ver cuántas sesiones suelen
        hacer falta y cada cuánto tiempo.
      </p>
    </div>

    <div class="planificador mt-10">
      <fieldset>
        <legend class="sr-only">Elige una zona del cuerpo</legend>
        <div class="flex flex-wrap gap-2.5">
          {zoneGroups.map((group) => (
            <>
              <input
                type="radio"
                name="zona"
                id={`zona-${group.id}`}
                value={group.id}
                checked={group.id === DEFAULT_ZONE}
                class="opcion-zona__input sr-only"
              />
              <label for={`zona-${group.id}`} class="opcion-zona">
                {group.name}
              </label>
            </>
          ))}
        </div>
      </fieldset>

      {zoneGroups.map((group) => {
        const [sMin, sMax] = group.sessions;
        const months = treatmentMonths(group);
        const hasPrices = group.zones.some((z) => z.price !== undefined);
        const ask = whatsappUrl(
          business.whatsapp,
          `Hola, me gustaría información y cita para ${treatmentPhrase(group)}.`,
        );
        return (
          <div
            class="panel-zona mt-6 gap-10 rounded-[var(--radius-panel)] bg-nacar p-7 ring-1 ring-linea sm:p-10 lg:grid-cols-[1.1fr_1fr] lg:gap-14 lg:p-12"
            data-zona={group.id}
          >
            <div>
              <h3 class="text-[2rem] leading-tight">{group.name}</h3>
              <p class="mt-3 max-w-[32rem] text-velo">{group.summary}</p>
              <ul
                class="mt-6 flex flex-wrap gap-2"
                aria-label={`Zonas de ${group.name.toLowerCase()}`}
              >
                {group.zones.map((zone) => (
                  <li class="rounded-full border border-linea bg-polvo px-3.5 py-1.5 text-[0.9375rem]">
                    {zone.name}
                    {zone.price !== undefined && (
                      <span class="text-cobre"> desde {euros.format(zone.price)}</span>
                    )}
                  </li>
                ))}
              </ul>
            </div>

            <div class="lg:border-l lg:border-linea lg:pl-14">
              <dl class="grid grid-cols-3 gap-4">
                <div>
                  <dt class="text-[0.875rem] text-velo">Sesiones</dt>
                  <dd class="mt-1 font-serif text-[1.75rem] leading-none sm:text-[2.125rem]">
                    {range(group.sessions)}
                  </dd>
                </div>
                <div>
                  <dt class="text-[0.875rem] text-velo">Cada</dt>
                  <dd class="mt-1 font-serif text-[1.75rem] leading-none sm:text-[2.125rem]">
                    {range(group.intervalWeeks)}
                    <span class="block pt-1.5 font-sans text-[0.875rem] text-velo">semanas</span>
                  </dd>
                </div>
                <div>
                  <dt class="text-[0.875rem] text-velo">Duración</dt>
                  <dd class="mt-1 font-serif text-[1.75rem] leading-none sm:text-[2.125rem]">
                    {range(months)}
                    <span class="block pt-1.5 font-sans text-[0.875rem] text-velo">meses</span>
                  </dd>
                </div>
              </dl>

              <div class="mt-8">
                <div class="sesiones" aria-hidden="true">
                  {Array.from({ length: sMax }, (_, i) => (
                    <span
                      class:list={['sesion', { 'sesion--opcional': i >= sMin }]}
                      style={`--i: ${i}; --n: ${sMin}`}
                    />
                  ))}
                </div>
                <p
                  class="mt-3 flex flex-wrap gap-x-5 gap-y-1 text-[0.875rem] text-velo"
                  aria-hidden="true"
                >
                  <span class="flex items-center gap-2">
                    <span class="sesion sesion--muestra" /> Previstas
                  </span>
                  <span class="flex items-center gap-2">
                    <span class="sesion sesion--opcional sesion--muestra" /> Según tu evolución
                  </span>
                </p>
              </div>

              <div class="mt-9 flex flex-col gap-4">
                <a
                  class="btn btn-principal w-full sm:w-auto sm:self-start"
                  href={ask}
                  target="_blank"
                  rel="noopener"
                >
                  <Icon name="chat" />
                  Pedir cita para {group.name.toLowerCase()}
                </a>
                <p class="text-[0.875rem] text-velo">
                  {hasPrices ? 'Precios por sesión. ' : 'Te damos el precio por WhatsApp. '}
                  Valores orientativos: tu plan se ajusta en la primera valoración.
                </p>
              </div>
            </div>
          </div>
        );
      })}
    </div>
  </div>
</section>

<style
  is:inline
  set:html={`.panel-zona{display:grid}@supports selector(:has(*)){.panel-zona{display:none}${panelCss}}`}
></style>

<style>
  .opcion-zona {
    display: inline-flex;
    align-items: center;
    min-height: 2.875rem;
    padding: 0.6rem 1.25rem;
    border-radius: 999px;
    border: 1px solid var(--color-borde);
    background-color: var(--color-nacar);
    font-size: 1rem;
    cursor: pointer;
    transition:
      background-color 0.2s ease,
      color 0.2s ease,
      border-color 0.2s ease;
    user-select: none;
  }

  .opcion-zona:hover {
    border-color: var(--color-cobre);
  }

  .opcion-zona__input:checked + .opcion-zona {
    background-color: var(--color-cacao);
    border-color: var(--color-cacao);
    color: var(--color-polvo);
  }

  .opcion-zona__input:focus-visible + .opcion-zona {
    outline: 2px solid var(--color-cobre);
    outline-offset: 3px;
  }

  /* Cada punto es una sesión; se van aclarando porque cada vez queda menos vello. */
  .sesiones {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .sesion {
    display: inline-block;
    width: 0.95rem;
    height: 0.95rem;
    border-radius: 999px;
    background-color: var(--color-cobre);
    opacity: calc(1 - (var(--i, 0) / var(--n, 1)) * 0.6);
  }

  .sesion--opcional {
    background-color: transparent;
    border: 1.5px solid var(--color-borde);
    opacity: 1;
  }

  .sesion--muestra {
    --i: 0;
    width: 0.75rem;
    height: 0.75rem;
  }
</style>
