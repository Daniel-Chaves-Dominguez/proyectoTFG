---
/**
 * Emblema de la marca (anillo, rama, monograma y destello) con la animación de entrada:
 * un punto de luz «láser» dibuja el anillo, se enciende el destello y un brillo recorre el MC.
 * Sin JavaScript. Con «reducir movimiento» se muestra directamente el estado final.
 */
import {
  BRANCH_PATH,
  DOTS,
  MC_PATH,
  RING,
  RING_ARC,
  RING_SHAPE,
  SPARKLE_PATH,
  TAIL_ARC,
} from './emblem-paths';

interface Props {
  /** Prefijo de los id internos (por si hubiera más de un emblema en la página). */
  id?: string;
  animate?: boolean;
  class?: string;
}

const { id = 'emblema', animate = true, class: className } = Astro.props;
const ref = (name: string) => `${id}-${name}`;

// Retardos de entrada de los puntos: los dos previos «anuncian» el trazo y los dos finales lo cierran.
const dotDelays = [0.25, 0.1, 2.2, 2.32];
---

<svg
  class:list={['emblema', { 'emblema--animado': animate }, className]}
  viewBox="110 25 1000 830"
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <linearGradient
      id={ref('mc')}
      x1="389"
      y1="212"
      x2="961"
      y2="739"
      gradientUnits="userSpaceOnUse"
    >
      <stop offset="0" stop-color="#C98276"></stop>
      <stop offset=".18" stop-color="#EBA79C"></stop>
      <stop offset=".32" stop-color="#D38A7E"></stop>
      <stop offset=".5" stop-color="#F4BDB2"></stop>
      <stop offset=".66" stop-color="#CD8476"></stop>
      <stop offset=".84" stop-color="#E9A598"></stop>
      <stop offset="1" stop-color="#BF786B"></stop>
    </linearGradient>
    <linearGradient
      id={ref('hoja')}
      x1="136"
      y1="281"
      x2="351"
      y2="821"
      gradientUnits="userSpaceOnUse"
    >
      <stop offset="0" stop-color="#E7A497"></stop>
      <stop offset=".45" stop-color="#F0B4A8"></stop>
      <stop offset=".7" stop-color="#DC968A"></stop>
      <stop offset="1" stop-color="#C98174"></stop>
    </linearGradient>
    <linearGradient
      id={ref('anillo')}
      x1="213"
      y1="66"
      x2="1076"
      y2="929"
      gradientUnits="userSpaceOnUse"
    >
      <stop offset="0" stop-color="#D99389"></stop>
      <stop offset=".5" stop-color="#E9AFA5"></stop>
      <stop offset="1" stop-color="#C98174"></stop>
    </linearGradient>
    <radialGradient id={ref('luz')}>
      <stop offset="0" stop-color="#FFFFFF"></stop>
      <stop offset=".18" stop-color="#FFF1EC" stop-opacity=".95"></stop>
      <stop offset=".45" stop-color="#F7C6BB" stop-opacity=".45"></stop>
      <stop offset="1" stop-color="#F4BDB2" stop-opacity="0"></stop>
    </radialGradient>
    <linearGradient id={ref('brillo')} x1="0" y1="0" x2="1" y2=".35">
      <stop offset=".38" stop-color="#FFFFFF" stop-opacity="0"></stop>
      <stop offset=".5" stop-color="#FFF8F5" stop-opacity=".8"></stop>
      <stop offset=".62" stop-color="#FFFFFF" stop-opacity="0"></stop>
    </linearGradient>
    <path id={ref('trazo-mc')} d={MC_PATH}></path>
    <clipPath id={ref('recorte-mc')}>
      <use href={`#${ref('trazo-mc')}`}></use>
    </clipPath>
    <mask id={ref('trazo')} maskUnits="userSpaceOnUse" x="110" y="25" width="1000" height="830">
      <path
        class="emblema__trazo"
        d={RING_ARC}
        pathLength="1"
        fill="none"
        stroke="#FFFFFF"
        stroke-width="18"
      ></path>
    </mask>
  </defs>

  {DOTS.map((dot, i) => (
    <circle
      class="emblema__punto"
      cx={dot.cx}
      cy={dot.cy}
      r={dot.r}
      fill="#C98477"
      style={`--retraso: ${dotDelays[i]}s`}
    />
  ))}

  <path
    class="emblema__anillo"
    d={RING_SHAPE}
    fill={`url(#${ref('anillo')})`}
    mask={`url(#${ref('trazo')})`}
  ></path>
  <path
    class="emblema__punto"
    style="--retraso: 2.44s"
    d={TAIL_ARC}
    fill="none"
    stroke="#C98477"
    stroke-width="2.4"
    stroke-linecap="round"
  ></path>

  <g class="emblema__rama">
    <path d={BRANCH_PATH} fill={`url(#${ref('hoja')})`}></path>
  </g>

  <g class="emblema__mc">
    <use href={`#${ref('trazo-mc')}`} fill={`url(#${ref('mc')})`}></use>
    <g clip-path={`url(#${ref('recorte-mc')})`}>
      <rect
        class="emblema__brillo"
        x="150"
        y="200"
        width="260"
        height="560"
        fill={`url(#${ref('brillo')})`}
      ></rect>
    </g>
  </g>

  <path class="emblema__destello" d={SPARKLE_PATH} fill="#CF8A7D"></path>

  <g transform={`translate(${RING.cx} ${RING.cy})`}>
    <g class="emblema__cabeza">
      <circle cx={RING.r} cy="0" r="34" fill={`url(#${ref('luz')})`}></circle>
      <circle cx={RING.r} cy="0" r="3.5" fill="#FFFFFF"></circle>
    </g>
  </g>
</svg>

<style>
  .emblema {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .emblema__trazo {
    stroke-dasharray: 1 1.01;
    stroke-dashoffset: 0;
  }

  .emblema__cabeza {
    opacity: 0;
  }

  .emblema__mc,
  .emblema__destello {
    transform-box: fill-box;
    transform-origin: center;
  }

  .emblema__brillo {
    transform: translateX(-200px);
  }

  @media (prefers-reduced-motion: no-preference) {
    .emblema--animado {
      --dibujo: 1.8s;
      --inicio: 0.4s;
    }

    .emblema--animado .emblema__trazo {
      animation: emblema-trazo var(--dibujo) var(--ease-luz) var(--inicio) both;
    }

    .emblema--animado .emblema__cabeza {
      animation:
        emblema-giro var(--dibujo) var(--ease-luz) var(--inicio) both,
        emblema-cabeza var(--dibujo) linear var(--inicio) both;
    }

    .emblema--animado .emblema__punto {
      animation: emblema-aparece 0.5s ease-out var(--retraso, 0s) both;
    }

    .emblema--animado .emblema__rama {
      animation: emblema-crece 1.4s var(--ease-luz) 0.6s both;
    }

    .emblema--animado .emblema__mc {
      animation: emblema-mc 1.2s ease-out 0.2s both;
    }

    .emblema--animado .emblema__destello {
      animation: emblema-destello 0.7s cubic-bezier(0.2, 0.9, 0.3, 1.3) 2s both;
    }

    .emblema--animado .emblema__brillo {
      animation: emblema-brillo 1.2s ease-in-out 2.3s both;
    }
  }

  @keyframes emblema-trazo {
    from {
      stroke-dashoffset: 1;
    }
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes emblema-giro {
    from {
      transform: rotate(-133deg);
    }
    to {
      transform: rotate(30.5deg);
    }
  }

  @keyframes emblema-cabeza {
    0% {
      opacity: 0;
    }
    8%,
    88% {
      opacity: 1;
    }
    100% {
      opacity: 0;
    }
  }

  @keyframes emblema-aparece {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes emblema-crece {
    from {
      clip-path: inset(100% 0 0 0);
      opacity: 0.2;
    }
    to {
      clip-path: inset(0 0 0 0);
      opacity: 1;
    }
  }

  @keyframes emblema-mc {
    from {
      opacity: 0;
      transform: scale(0.965);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  @keyframes emblema-destello {
    0% {
      opacity: 0;
      transform: scale(0) rotate(-60deg);
    }
    60% {
      opacity: 1;
      transform: scale(1.3) rotate(0deg);
    }
    100% {
      opacity: 1;
      transform: scale(1) rotate(0deg);
    }
  }

  @keyframes emblema-brillo {
    from {
      transform: translateX(-200px);
    }
    to {
      transform: translateX(900px);
    }
  }
</style>
