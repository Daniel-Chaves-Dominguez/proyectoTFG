---
/** Destello de cuatro puntas del logo, para viñetas y separadores. Decorativo. */
interface Props {
  size?: number;
  class?: string;
}
const { size = 12, class: className } = Astro.props;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="currentColor"
  aria-hidden="true"
  focusable="false"
>
  <path d="M12 0c.6 7.2 4.8 11.4 12 12-7.2.6-11.4 4.8-12 12-.6-7.2-4.8-11.4-12-12 7.2-.6 11.4-4.8 12-12Z"></path>
</svg>
