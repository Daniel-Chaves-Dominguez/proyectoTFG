---
import { faq } from '../data/faq';
import { links } from '../data/links';
---

<section id="preguntas" class="seccion bg-rubor" aria-labelledby="preguntas-titulo">
  <div class="contenedor grid gap-x-14 gap-y-10 lg:grid-cols-12">
    <div class="lg:col-span-4">
      <div class="lg:sticky lg:top-28">
        <h2 id="preguntas-titulo" class="text-titulo">
          Preguntas frecuentes
        </h2>
        <p class="mt-5 max-w-[24rem] text-velo">
          ¿Tienes otra duda?{' '}
          <a href={links.whatsapp} class="enlace" target="_blank" rel="noopener">
            Escríbenos por WhatsApp
          </a>{' '}
          y te respondemos.
        </p>
      </div>
    </div>

    <div class="lg:col-span-8">
      <div class="border-t border-borde/40">
        {faq.map((item, i) => (
          <details class="pregunta border-b border-borde/40" name="preguntas" open={i === 0}>
            <summary class="pregunta__resumen">
              <span class="font-serif text-[1.375rem] leading-snug sm:text-[1.5rem]">
                {item.question}
              </span>
              <span class="pregunta__icono" aria-hidden="true" />
            </summary>
            <p class="max-w-[42rem] pb-6 text-velo">{item.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .pregunta__resumen {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: 1.25rem;
    cursor: pointer;
    list-style: none;
  }

  .pregunta__resumen::-webkit-details-marker {
    display: none;
  }

  .pregunta__resumen:hover {
    color: var(--color-cobre-oscuro);
  }

  /* «+» que gira a «×» al abrir */
  .pregunta__icono {
    position: relative;
    flex: none;
    width: 1.125rem;
    height: 1.125rem;
    transition: transform 0.3s var(--ease-luz);
  }

  .pregunta__icono::before,
  .pregunta__icono::after {
    content: '';
    position: absolute;
    inset: 50% 0 auto;
    height: 1.5px;
    margin-top: -0.75px;
    background-color: var(--color-cobre);
  }

  .pregunta__icono::after {
    transform: rotate(90deg);
  }

  .pregunta[open] .pregunta__icono {
    transform: rotate(45deg);
  }

  /* Apertura suave donde el navegador lo permite (Chrome/Edge); en el resto, instantánea. */
  @supports (interpolate-size: allow-keywords) {
    .pregunta {
      interpolate-size: allow-keywords;
    }

    .pregunta::details-content {
      block-size: 0;
      overflow: hidden;
      transition:
        block-size 0.35s var(--ease-luz),
        content-visibility 0.35s allow-discrete;
    }

    .pregunta[open]::details-content {
      block-size: auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pregunta__icono,
    .pregunta::details-content {
      transition: none;
    }
  }
</style>
